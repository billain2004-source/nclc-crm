# NCLC CRM environment configuration
# Copy this file to .env and fill in your values. Never commit .env.

# --- MySQL (localhost) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nclc_crm

# --- Backend API ---
API_PORT=4000
# Long random string used to sign login tokens (JWT)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Frontend origin allowed by CORS (comma separated for several)
CLIENT_ORIGIN=http://localhost:5173

# --- AI API keys (Settings > API Keys) ---
# Master key used to encrypt provider API keys at rest (AES-256-GCM). 64 hex characters (32 bytes).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret and back it up separately: if it changes, stored API keys can no longer be decrypted.
APP_ENC_KEY=
# Minutes between automatic checks that reactivate exhausted keys after their task type's reset window
AI_KEY_RESET_SWEEP_MINUTES=5
# Timeout for a single AI provider call (milliseconds)
LLM_TIMEOUT_MS=60000
