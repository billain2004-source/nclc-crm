# NCLC CRM environment configuration
# Copy this file to .env and fill in your values. Never commit .env.

# --- MySQL (localhost) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nclc_crm

# --- Backend API ---
API_PORT=4000
# Long random string used to sign login tokens (JWT)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Frontend origin allowed by CORS (comma separated for several)
CLIENT_ORIGIN=http://localhost:5173
